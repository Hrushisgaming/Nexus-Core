{
  "manifest_version": 3,
  "name": "Nexus Browser Control",
  "version": "0.2.0",
  "description": "Pair this browser with Nexus Core using a code, then let Nexus open, read and drive tabs. You stay in control.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nexus Browser Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Pause or resume Nexus control of this browser"
    },
    "send-selection": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "Send the selected text to Nexus"
    }
  },
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "alarms", "debugger", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
